DATABASE_URL=postgresql://razorflow:razorflow@localhost:5432/razorflow

DEMO_MERCHANT_ID=northline-audio

# Playwright loads .env and .env.local before starting the dev server so E2E
# Razorpay detection matches the application. Omit keys locally to exercise the
# unconfigured checkout failure path; set Test Mode keys to exercise real checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Phase 3B: LLM intent extraction (server-side only; never expose to the client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Phase 3D: signed buyer/merchant session tokens (server-side only)
RAZORFLOW_SESSION_SECRET=

# Phase 12: SMTP email verification (server-side only; never expose to the browser)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 12: bootstrap administrator (must verify email normally; not a domain rule)
INITIAL_ADMIN_EMAIL=
